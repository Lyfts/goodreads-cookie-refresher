# Copy to .env before `docker compose up` and fill in.

# Password for the noVNC login view (http://<host>:<VNC_PORT>). Required -- don't
# leave this on the default.
VNC_PASSWORD=changeme

# Host port for the noVNC login view.
VNC_PORT=7900

# Local account labels exposed by this refresher, not Goodreads usernames.
# Use comma-separated lowercase names (letters, digits, hyphens, underscores);
# each gets its own Chrome profile and title label. Selenium concurrency is
# set automatically to the number of accounts.
ACCOUNTS=default

# Optional shared secret the KOReader plugin must send when calling this
# service (as ?token=... or an X-Auth-Token header).
# Leave blank to disable -- fine if this is only reachable on a trusted LAN.
REFRESHER_AUTH_TOKEN=

# Host-side port the refresher's HTTP API is published on. Change this if
# 5080 is already taken on this machine -- update the plugin's "Cookie
# Auto-Refresh URL" setting to match if you do.
REFRESHER_PORT=5080
